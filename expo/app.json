{
  "expo": {
    "name": "CloQ",
    "slug": "9bbvfioiq3nf9s1e05ix8",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2E0B6"
    },
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.cloq-smart-alarm",
      "deploymentTarget": "26.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F2E0B6"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "CloQ needs microphone access to record custom alarm sounds. Your recordings are stored only on your device."
        }
      ],
      "./plugins/alarmkit/withAlarmKit"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
